# ============================================================================
# Server environment — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit it, and never paste a real secret here.
# ============================================================================

# ===== Server =====
PORT=5000
# "development" | "production". In production, 500 responses return a generic
# message instead of the internal error text.
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# Set this to your deployed frontend URL before going live.
CLIENT_URL=http://localhost:5173

# ===== Database =====
# Server-side only — never expose this to the browser.
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
MONGO_URI=your_mongodb_connection_string

# ===== Auth =====
# Signs every JWT — server-side only. Generate a fresh 64-byte value with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this invalidates all existing sessions (by design).
JWT_SECRET=a_long_random_secret_string

# Used by `npm run seed` to create (or promote) the one admin account. This is
# the ONLY way an account becomes an admin — registration always creates a plain
# user, so knowing this address grants nothing. Once the admin exists you can
# remove ADMIN_PASSWORD from the environment; the password lives hashed in the
# database from then on.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_seeding

# ===== Email (Brevo transactional API) =====
# Create a free account at https://www.brevo.com, then:
#   1. Settings > SMTP & API > API Keys  -> generate a key
#   2. Senders & IP > Senders           -> add + verify the sender address
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=Portfolio

# ===== Cloudinary =====
# CLOUD_NAME is public (it appears in delivery URLs).
# API_KEY and API_SECRET are secrets — server-side only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
