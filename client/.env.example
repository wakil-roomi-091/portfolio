# ============================================================================
# Client environment — copy to `.env` and fill in real values.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the JavaScript
# bundle it ships to the browser. Anyone can read them with View Source.
# Only put public values here — never an API secret, database URL, service
# role key, Stripe secret key, or JWT signing secret.
#
# Secrets belong in `server/.env`, read by the backend and never sent to the
# client. If the browser needs data that requires a secret, add a backend
# route that uses the secret server-side and returns only the result.
# ============================================================================

# Base URL of the backend API (public — it is just an address).
#
#   Local dev:  http://localhost:5000/api
#   Production: https://portfolio-production-7964.up.railway.app/api  (keep the /api)
#
# On Vercel, set VITE_API_URL under Settings > Environment Variables so the
# build points at your live backend. A gitignored .env file is not uploaded.
VITE_API_URL=http://localhost:5000/api
